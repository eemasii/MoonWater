{
  "name": "moonwater",
  "version": "1.0.0",
  "description": "Moonwater Astrological Studio - Professional Swiss Ephemeris Desktop Software",
  "main": "dist/electron-main.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "electron:dev": "tsc && electron dist/electron-main.js",
    "dist:portable": "tsc && electron-builder --win portable --config electron-builder.json",
    "dist:installer": "tsc && electron-builder --win nsis --config electron-builder.json",
    "dist:win": "tsc && electron-builder --win portable nsis --config electron-builder.json",
    "test": "tsx src/test.ts",
    "test:aspects": "tsx src/test_aspects.ts",
    "verify": "tsx src/verify_chart.ts"
  },
  "keywords": [
    "astrology",
    "swiss-ephemeris",
    "natal-chart",
    "transits",
    "synastry",
    "solar-fire"
  ],
  "author": "Moonwater Team",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.moonwater.astrology",
    "productName": "Moonwater Astrology",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@kuntay/swisseph/**",
      "**/node_modules/@kuntay/swisseph-data/**"
    ]
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@kuntay/swisseph": "^0.2.2",
    "@kuntay/swisseph-data": "^0.2.2",
    "express": "^5.3.0"
  }
}
